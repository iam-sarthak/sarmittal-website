# Optional. Without this, the site still deploys; the AI intake
# falls back to the local keyword matcher.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Canonical site URL for Open Graph / metadata.
# On Vercel this is inferred automatically if unset.
# NEXT_PUBLIC_SITE_URL=https://sarthakmittal.dev
